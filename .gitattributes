# The frozen v0.1 reference fixtures are byte-pinned: every SHA-256 in
# tests/reference/golden/manifest.json, in the native Tudat manifest and in
# tests/reference/acceptance.json is computed over the exact committed bytes.
# A Windows checkout with core.autocrlf=true rewrote those LF files to CRLF and
# the identities no longer matched the pins (run 39123791284: 17 failures in
# tests/python/test_regression.py::test_frozen_fixture_identities).
# -text keeps the committed bytes verbatim on every platform without turning
# reviewable JSON into an opaque blob.
tests/reference/acceptance.json -text
tests/reference/golden/*.json -text
tests/reference/golden/tudat/*.json -text
tests/reference/scenarios/*.json -text

# Public source members are compared byte-for-byte across wheel platforms.
# Keep their checkout representation LF rather than weakening those gates.
/LICENSE text eol=lf
/LICENSE_SCOPE.md text eol=lf
/THIRD_PARTY_NOTICES.md text eol=lf
/README.dist.md text eol=lf
/CMakeLists.txt text eol=lf
/pyproject.toml text eol=lf
/cmake/provision.cmake text eol=lf
/bindings/** text eol=lf
/python/leo_dynamics/** text eol=lf
/src/kernel/** text eol=lf
/src/integration/** text eol=lf
/src/analysis/** text eol=lf
/include/leo/kernel/** text eol=lf
/include/leo/integration/** text eol=lf
/include/leo/analysis/** text eol=lf
/include/leo/environment/ephemeris.hpp text eol=lf
/include/leo/environment/interpolated.hpp text eol=lf
/include/leo/environment/source.hpp text eol=lf