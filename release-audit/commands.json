      "-c",
      "import numpy as np\nimport leo_dynamics as leo\n\nearth = leo.Earth()\nradius = 7.0e6                                     # ~622 km above the reference radius\nspeed = float(np.sqrt(earth.mu_m3_s2 / radius))    # circular speed\n\ninitial = leo.State(position_m=[radius, 0.0, 0.0],\n                    velocity_m_s=[0.0, speed, 0.0])\n\nspacecraft = leo.Spacecraft(\n    mass_kg=500.0,\n    inertia_kg_m2=np.diag([40.0, 40.0, 20.0]),\n    surfaces=[\n        leo.Surface(area_m2=12.0,\n                    normal_body=[0.0, 0.0, 1.0],\n                    center_of_pressure_body_m=[0.0, 0.0, 0.0])\n    ],\n)\n\nmodel = leo.DynamicsModel(gravity=\"j2\")\ntimes_s = np.arange(0.0, 5400.0 + 5.0, 5.0)\n\ntrajectory = leo.propagate(initial=initial,\n                           spacecraft=spacecraft,\n                           model=model,\n                           times_s=times_s,\n                           earth=earth)\n\nprint(trajectory.states.shape)        # (1081, 13)\nprint(trajectory.position_m[-1])      # final position in metres\n\nimport tempfile, pathlib\nenv=leo.Environment(sun=leo.SunEphemeris.constant([1e11,0,0]), atmosphere=leo.ExponentialAtmosphere())\nloads=leo.DynamicsModel(gravity=\"j2\", srp=leo.Contribution(force=True,torque=True), drag=leo.Contribution(force=True,torque=True), drag_law=\"sentman\", albedo=leo.Contribution(force=True,torque=True), gravity_gradient=True)\nloaded=leo.propagate(initial=initial,spacecraft=spacecraft,model=loads,times_s=np.arange(0,1801,10),environment=env)\nbatch=leo.propagate_batch(initials=[initial]*3,spacecraft=spacecraft,model=model,times_s=np.arange(0,601,10),workers=2)\nassert batch.states.shape==(3,61,13)\nassert np.isfinite(loaded.states).all()\nwith tempfile.TemporaryDirectory() as tmp:\n    leo.analysis.export_csv(trajectory,tmp)\n    names=sorted(p.name for p in pathlib.Path(tmp).iterdir())\n    assert len(names)==9\n    print(\"CSV\",names)\nprint(\"environment\",loaded.states.shape,\"batch\",batch.states.shape,\"SMOKE PASS\")\n"
