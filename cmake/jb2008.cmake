enable_language(Fortran)
find_package(Threads REQUIRED)
set(LEO_JB2008_SOURCE "" CACHE FILEPATH "Local unmodified official JB2008.f source")
if(NOT EXISTS "${LEO_JB2008_SOURCE}")
  message(FATAL_ERROR "JB2008 requires externally acquired official source; see docs/atmosphere/README.md")
endif()
file(SHA256 "${LEO_JB2008_SOURCE}" _jb_hash)
if(NOT _jb_hash STREQUAL "b18c1607239db881940a7b91635a7af39edc82306cf10854ec12080397227999")
  message(FATAL_ERROR "Official JB2008.f hash mismatch")
endif()
if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  message(FATAL_ERROR "JB2008 baseline supports GNU Fortran; other compiler ABIs require validation")
endif()
add_library(leo_jb2008_reference STATIC "${LEO_JB2008_SOURCE}" src/atmosphere/jb2008_bridge.f90)
set_source_files_properties("${LEO_JB2008_SOURCE}" PROPERTIES Fortran_FORMAT FIXED)
target_compile_options(leo_jb2008_reference PRIVATE -std=legacy)
target_sources(leo_atmosphere PRIVATE src/atmosphere/jb2008.cpp)
target_compile_definitions(leo_atmosphere PUBLIC LEO_HAS_JB2008=1)
target_link_libraries(leo_atmosphere PRIVATE leo_jb2008_reference Threads::Threads)
